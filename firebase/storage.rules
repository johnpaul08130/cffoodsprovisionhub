rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: get user role from Firestore (requires extra permission)
    // For simplicity we allow authenticated users to upload with size/type limits.
    // Strict role checks for Storage are better done via Cloud Functions in production.

    // ============================================================
    // PRODUCT IMAGES
    // ============================================================
    match /products/{productId}/{fileName} {
      // Anyone logged in can read product images
      allow read: if isAuthenticated();

      // Only authenticated users can upload (size limit 5MB, images only)
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Only authenticated users can delete
      allow delete: if isAuthenticated();
    }

    // ============================================================
    // STORE LOGO / SETTINGS IMAGES
    // ============================================================
    match /settings/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    // ============================================================
    // GENERAL UPLOADS (fallback)
    // ============================================================
    match /uploads/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}